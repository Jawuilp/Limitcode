{
    "default_provider": "openai",
    "default_model": "gpt-5.5",
    "api_key": "",
    "provider_base_urls": {},
    // "auto" uses the provider/model default. A number overrides it.
    "temperature": "auto",
    // Maximum output tokens. Use "auto" for the provider's known model limit.
    "max_tokens": 8192,
    "max_iterations": 50,
    // Reasoning/thinking effort: "off", "low", "medium" or "high".
    // Mapped per provider (Anthropic output_config.effort, OpenAI
    // reasoning_effort and Gemini thinkingBudget).
    // Models without reasoning support ignore it or keep current behavior.
    "reasoning_effort": "off",
    "chat_bottom_spacer_height": "16rem",
    "show_thoughts": false,
    "hide_minimap_in_chat": true,
    // Mirror the plugin console to history/sublime_console.log and trace
    // chat-view commands. Development aid; leave off for normal use.
    "debug_console_log": false
}
